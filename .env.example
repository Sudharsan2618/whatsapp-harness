# Postgres. Either a full URL, or the discrete DB_* parts below.
# External/managed Postgres (e.g. Render) requires SSL.
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=wa_bot
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_SSL=false

# Redis (used for caches and the outbound queue)
REDIS_URL=redis://127.0.0.1:6379

WORKER_ID=worker-local
MAX_SESSIONS_PER_WORKER=20

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# HTTP port. Cloud Run sets this automatically (8080); leave blank locally for 8787.
PORT=

# Model provider keys — set the ones you use; tenants pick a provider in config.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Firecrawl — powers agentic onboarding (site map, page selection, scraping).
FIRECRAWL_API_KEY=
